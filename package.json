{
  "name": "wisuda-platform",
  "version": "2.0.0",
  "description": "Graduation Photography Agency Platform (based on Sorehari style)",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "cron": "node src/services/cron.service.js",
    "migrate": "node -e \"require('./src/config/database').migrate()\"",
    "seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "test": "NODE_ENV=test jest --runInBand --testTimeout=10000",
    "health": "curl -s http://localhost:8081/api/health | jq .",
    "bump": "npm version patch --no-git-tag-version"
  },
  "keywords": [
    "wisuda",
    "photography",
    "agency",
    "graduation"
  ],
  "author": "AMSDEV",
  "license": "MIT",
  "dependencies": {
    "alpinejs": "^3.15.12",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-fileupload": "^1.5.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "globalTeardown": "<rootDir>/scripts/jest-global-teardown.js",
    "testPathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/main.js"
    ]
  },
  "directories": {
    "doc": "master_docs"
  }
}
