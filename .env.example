# ===================================================
# WISUDA MANAGEMENT SYSTEM - ENVIRONMENT CONFIG (.env.example)
# ===================================================

# Port Server Backend API (Default: 8081)
PORT=8081

# Daftar origin yang diizinkan mengakses API (CORS) — pisahkan dengan koma, tanpa spasi
# Tambahkan IP/domain server jika diakses dari jaringan luar localhost
# Contoh produksi: CORS_ORIGINS=http://192.168.1.100:8081,https://domain-anda.com
CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:3000

# Node Environment (development / production)
NODE_ENV=production

# Lokasi File Database SQLite (Otomatis dibuat jika belum ada)
DB_PATH=./DATA/wisuda.db

# Secret Key untuk Session & Cookie Admin (Otomatis di-generate acak saat deploy)
SESSION_SECRET=

# Secret Key untuk Token JWT Portal Freelance (Otomatis di-generate acak saat deploy)
JWT_SECRET=

# Catatan: Pengaturan Lokasi Storage Disk (Disk 1, Disk 2, dan Backup Database)
# TIDAK PERLU DIATUR DI .ENV! Semuanya dikelola 100% langsung via visual UI di:
# Admin Panel > Settings > Sistem & Storage.

# Catatan: Integrasi Google Drive (Service Account JSON, Master Folder ID, & API Key)
# tidak perlu lagi diatur di .env. Semuanya dikelola langsung via Admin Panel > Settings > Google Drive.

# Kunci Keamanan Hard Reset Sistem (Pembersihan Data / Reset Pabrik via Admin UI)
# Catatan: WAJIB diisi oleh Root / Superadmin saat pertama kali setup server demi keamanan!
HARD_RESET_PASSWORD=AmsDev123

# Secret untuk proteksi Webhook Cron Endpoints (/api/webhook/cron/*)
# Wajib diisi! Tanpa ini, semua endpoint cron webhook akan ditolak (401).
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=


# Aktivasi fitur enkripsi fungsional — hubungi developer untuk informasi lebih lanjut

# ===================================================
# DEVELOPER WATERMARK CONFIGURATION (AMS Credit)
# ===================================================
# Kontrol tampilan watermark developer melayang (AMS Credit Bubble):
# Set 'true' untuk menampilkan, atau 'false' untuk menyembunyikan.
SHOW_DEV_WATERMARK=true

# (Opsional) Kode Lisensi / Kunci Rahasia Pembuka:
# Jika diisi 'AMS-HIDE' atau 'DISABLE', watermark otomatis disembunyikan.
DEV_WATERMARK_KEY=