# ===================================================
# WISUDA MANAGEMENT SYSTEM - ENVIRONMENT CONFIG (.env.example)
# ===================================================

# Port Server Backend API (Default: 8081)
PORT=8081

# Node Environment (development / production)
NODE_ENV=production

# Lokasi File Database SQLite (Otomatis dibuat jika belum ada)
DB_PATH=./DATA/wisuda.db

# Secret Key untuk Session & Cookie Admin (Otomatis di-generate acak saat deploy)
SESSION_SECRET=

# Secret Key untuk Token JWT Portal Freelance (Otomatis di-generate acak saat deploy)
JWT_SECRET=

# Folder Utama Penyimpanan File Upload (Contoh Server/Production: /mnt/DATA1/wisuda/uploads)
# WAJIB DIISI! Jika kosong atau folder tidak ditemukan, server akan otomatis dihentikan (Fail-Fast)
UPLOAD_PATH=

# Folder Utama Penyimpanan Backup Database Otomatis (Contoh Server/Production: /mnt/DATA1/wisuda/backups)
# WAJIB DIISI! Jika kosong, server akan otomatis dihentikan (Fail-Fast)
BACKUP_PATH=

# Google Drive API Key (untuk baca file publik / portfolio import)
GOOGLE_DRIVE_API_KEY=

# Google Drive Service Account — untuk otomasi pembuatan folder saat DP terverifikasi
# Path ke file credentials JSON yang didownload dari Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_PATH=./DATA/service-account.json

# ID Folder Master di Google Drive (folder "WISUDA CLIENTS" yang di-share ke service account)
# Ambil dari URL: drive.google.com/drive/folders/[INI_ID_NYA]
GOOGLE_DRIVE_MASTER_FOLDER_ID=

# Kunci Keamanan Hard Reset Sistem (Pembersihan Data / Reset Pabrik via Admin UI)
# Catatan: WAJIB diisi oleh Root / Superadmin saat pertama kali setup server demi keamanan!
Hardresetsistem=

