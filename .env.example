# ===================================================
# LUXENARY.CO - WISUDA MANAGEMENT SYSTEM ENV CONFIG
# ===================================================

# Port Server Backend API (Default: 8081)
PORT=8081

# Node Environment (development / production)
NODE_ENV=production

# Lokasi File Database SQLite (Otomatis dibuat jika belum ada)
DB_PATH=./DATA/wisuda.db

# -----------------------------------------------------------------------------------
# KUNCI RAHASIA KEAMANAN (SESSION & JWT SECRET)
# Catatan: Kunci ini BUKAN API Key luar, melainkan String Rahasia yang Anda buat sendiri
# di server untuk mengenkripsi Cookie Session Admin & Token JWT Freelancer.
#
# Cara Generate String Acak Aman di Server (Jalankan di Terminal):
# Cara A (OpenSSL): openssl rand -hex 32
# Cara B (Node.js): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------------

# Secret Key untuk Session & Authentication Cookie Admin
SESSION_SECRET=e7b4a9c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9

# Secret Key untuk JWT Token Portal Freelance
JWT_SECRET=f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8

# Folder Utama Penyimpanan File Upload (Portfolio, Bukti Transfer, Setor File)
UPLOAD_PATH=./DATA/uploads

# Folder Utama Penyimpanan Backup Database Otomatis
BACKUP_PATH=./DATA/backups

# Google Drive API Key
# Diperlukan untuk Impor Portofolio dari Link Google Drive secara Otomatis (Drive API + Sharp Compression)
# Cara Dapatkan: Google Cloud Console -> APIs & Services -> Credentials -> Create API Key -> Enable Google Drive API
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# Akun Login Admin Default saat Inisialisasi Database Pertama Kali
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
